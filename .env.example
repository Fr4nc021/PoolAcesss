# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# Nunca commite o arquivo .env.

# Facial da piscina normal. O endereço precisa terminar em .86
DEVICE_URL=http://192.168.x.86
# Facial da piscina térmica. O endereço precisa terminar em .44
# No cadastro dá para marcar uma piscina ou as duas.
DEVICE_URL_2=http://192.168.x.44
DEVICE_LOGIN=admin
DEVICE_PASSWORD=sua_senha_aqui

# Validade do exame médico (dias), hora do dia em que vence e intervalo do job de expiração
VALIDITY_DAYS=30
EXPIRY_HOUR=22
EXPIRY_CHECK_MINUTES=15

# Servidor Flask
HOST=0.0.0.0
PORT=5000
SECRET_KEY=troque-esta-chave-em-producao

# IP deste PC na LAN (usado em URLs públicas para o equipamento baixar fotos)
SERVER_LAN_IP=SEU_IP_DO_SERVIDOR

# Porta / canal OpenDoor no equipamento
DOOR_NUM=1

# Outro PC na rede do clube. Cada instalação aponta para o endereço da outra.
# Os dois usam o mesmo SYNC_TOKEN. Sem estas linhas, o programa funciona num PC só.
SYNC_PEER_URL=
SYNC_TOKEN=
SYNC_INTERVAL_SECONDS=20

# Backup e troca pela internet (Supabase). Sem URL, a nuvem fica desligada.
# Rode scripts/supabase_schema.sql no SQL Editor e use a chave service_role.
# SUPABASE_KEY não vai para o navegador e não deve ser commitada.
SUPABASE_URL=
SUPABASE_KEY=
