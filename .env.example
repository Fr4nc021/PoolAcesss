# Copie este arquivo para .env e preencha com os valores do seu ambiente.
# Nunca commite o arquivo .env.

# URL do facial Intelbras (ex.: http://192.168.x.x)
DEVICE_URL=http://SEU_IP_DO_FACIAL
DEVICE_LOGIN=admin
DEVICE_PASSWORD=sua_senha_aqui

# Validade do exame médico (dias) e intervalo do job de expiração
VALIDITY_DAYS=30
EXPIRY_CHECK_MINUTES=15

# Servidor Flask
HOST=0.0.0.0
PORT=5000
SECRET_KEY=troque-esta-chave-em-producao

# IP deste PC na LAN (usado em URLs públicas para o equipamento baixar fotos)
SERVER_LAN_IP=SEU_IP_DO_SERVIDOR

# Porta / canal OpenDoor no equipamento
DOOR_NUM=1
